# Die Oberfläche bleibt standardmäßig nur auf diesem Rechner erreichbar.
APP_PORT=8080
SCRIPT_PROVIDER=ollama

# Vollständig lokale Skripterstellung. Der Dienst darf nur auf 127.0.0.1 oder
# als abgeschotteter Compose-Dienst unter dem Hostnamen "ollama" laufen.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q8_0
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=720
OLLAMA_KEEP_ALIVE=5m

# Cloudanbieter sind nur bei ausdrücklicher Auswahl nutzbar. Sie sind niemals
# Ersatzpfad für einen Fehler des lokalen Modells.
# Gemini bietet derzeit ein begrenztes Free Tier; dort eingereichte Inhalte
# können laut Anbieter zur Produktverbesserung verwendet werden.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Offizielle Gemini CLI mit regulär angemeldeten, getrennten Profilen.
# Keine Tokens eintragen: jedes Profil wird interaktiv über `gemini` angemeldet.
# Erst nach erfolgreichem Profiltest aktivieren.
GEMINI_CLI_ENABLED=0
GEMINI_CLI_PROFILES=primary,secondary
GEMINI_CLI_PROFILE_ROOT=
GEMINI_CLI_COMMAND=gemini
GEMINI_CLI_TIMEOUT_SECONDS=300
GEMINI_CLI_COOLDOWN_SECONDS=300

# OpenAI-API-Nutzung wird getrennt von ChatGPT/Codex abgerechnet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1

# Nur mit ausdrücklich gewähltem Modell; wechselnde Gratisangebote werden nicht
# unbemerkt als Qualitätsstandard verwendet.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Ausschließlich für lokale Entwicklungs-/Workflowtests, nicht für Produktion.
ALLOW_TEMPLATE_SCRIPT=0

# Kostenlose Stockfotos/-videos. Schlüssel gibt es über ein Pexels-Konto.
# Die Oberfläche zeigt die vorgeschriebene Pexels-Verlinkung und speichert
# Urheber-/Lizenzdaten im Assetmanifest.
ASSET_PROVIDER=auto
PEXELS_API_KEY=
MEDIA_DOWNLOAD_MAX_MB=150

# Lokaler Import bereits heruntergeladener Gemini-/NotebookLM-MP4s.
# Dieser Weg nutzt das Consumer-Abo ohne eine zusätzliche API-Abrechnung.
EXTERNAL_IMPORT_MAX_MB=500

# Kostet Geld und bleibt gesperrt, bis es ausdrücklich freigegeben wird.
ALLOW_PAID_MEDIA=0

# Lokaler, garantiert kostenfreier Standard. Für natürlichere Cloud-Stimme muss
# Gemini TTS zusätzlich und bewusst freigeschaltet werden. Dessen Free Tier kann
# Inhalte zur Produktverbesserung verwenden und ein abrechenbares Projekt kann
# nach Ausschöpfen des Freikontingents Kosten verursachen.
TTS_PROVIDER=piper
PIPER_VOICE=de_DE-thorsten-high
PIPER_AUTO_DOWNLOAD=1
ALLOW_CLOUD_TTS=0
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Iapetus
GEMINI_TTS_STYLE=Natural documentary narration, warm and confident, clear articulation, moderate pace, no exaggerated advertising tone.

# YouTube bleibt aus, bis OAuth-Dateien eingerichtet und der Schalter bewusst aktiviert ist.
YOUTUBE_ENABLED=0
YOUTUBE_CLIENT_SECRETS_FILE=/data/secrets/youtube-client.json
YOUTUBE_TOKEN_FILE=/data/secrets/youtube-token.json
YOUTUBE_PRIVACY_STATUS=private

# Zweiter automatischer Multi-Channel-Adapter. Token nur lokal in .env setzen.
# Die Instanz muss eine feste HTTPS-Adresse sein; Standard-Sichtbarkeit bleibt privat.
MASTODON_ENABLED=0
MASTODON_BASE_URL=https://social.example
MASTODON_ACCESS_TOKEN=
MASTODON_VISIBILITY=private
